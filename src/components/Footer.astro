---
import { site, whatsappLink } from '../data/site';
import { stays } from '../data/stays';
import { u } from '../lib/url';
---
<footer class="footer">
  <div class="wrap">
    <p class="big">your village,<br />anywhere.</p>
    <div class="grid" style="--min:180px">
      <div>
        <p class="label" style="color:var(--marigold);margin-bottom:8px">Stays</p>
        {stays.map((s) => <a href={u(`/stays/${s.slug}/`)}>{s.property}, {s.name}</a>)}
        <a href={u('/coworking/')}>Coworking passes</a>
        <a href={u('/teams/')}>Team retreats</a>
      </div>
      <div>
        <p class="label" style="color:var(--marigold);margin-bottom:8px">Community</p>
        <a href={u('/happenings/')}>Happenings</a>
        <a href={u('/village/')}>Member profiles</a>
        <a href={u('/passport/')}>NomadGao Passport</a>
        <a href={u('/digital-nomads-india/')}>Digital nomads in India</a>
        <a href={u('/volunteer/')}>Volunteer</a>
      </div>
      <div>
        <p class="label" style="color:var(--marigold);margin-bottom:8px">Read</p>
        <a href={u('/blog/')}>The Journal</a>
        <a href={u('/guides/')}>Destination guides</a>
        <a href={u('/faq/')}>FAQ</a>
        <a href={u('/about/')}>Our story</a>
        <a href={u('/contact/')}>Contact</a>
      </div>
      <div>
        <p class="label" style="color:var(--marigold);margin-bottom:8px">Talk to a host</p>
        <a href={whatsappLink('Hi NomadGao! I have a question about staying with you.')} rel="noopener" target="_blank">WhatsApp us</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.social.instagram} rel="noopener" target="_blank">Instagram</a>
        <a href={site.social.youtube} rel="noopener" target="_blank">YouTube</a>
        <a href={u('/rss.xml')}>RSS</a>
      </div>
    </div>
    <p class="label" style="margin-top:56px;color:#8A8174">
      © {new Date().getFullYear()} NomadGao ·
      <a style="display:inline" href={u('/legal/privacy/')}>Privacy</a> ·
      <a style="display:inline" href={u('/legal/terms/')}>Terms</a> ·
      <a style="display:inline" href={u('/legal/cancellations/')}>Cancellations</a>
    </p>
  </div>
</footer>
