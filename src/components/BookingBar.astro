---
import { stays } from '../data/stays';
import { u } from '../lib/url';
interface Props { preset?: string }
const { preset } = Astro.props;
---
<form action={u('/book/')} method="get" class="bookbar" style="display:flex;flex-wrap:wrap;background:var(--white);border:2px solid var(--ink);border-radius:20px;overflow:hidden;max-width:760px">
  <label class="field" style="flex:1 1 180px;padding:12px 18px;border-right:1px solid var(--line)"><span>Where</span>
    <select name="stay" style="border:0;padding:4px 0;min-height:auto;font-weight:600">
      {stays.map((s) => <option value={s.slug} selected={s.slug === preset}>{s.name}, {s.state}</option>)}
    </select>
  </label>
  <label class="field" style="flex:1 1 150px;padding:12px 18px;border-right:1px solid var(--line)"><span>Arrive</span>
    <input type="date" name="in" required style="border:0;padding:4px 0;min-height:auto;font-weight:600" />
  </label>
  <label class="field" style="flex:1 1 150px;padding:12px 18px"><span>Stay for</span>
    <select name="len" style="border:0;padding:4px 0;min-height:auto;font-weight:600">
      <option value="7">A week</option><option value="30">A month</option><option value="2">A weekend</option><option value="14">Two weeks</option>
    </select>
  </label>
  <button class="btn" type="submit" style="border-radius:0;min-height:68px;flex:1 0 auto">Check dates</button>
</form>
