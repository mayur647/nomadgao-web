---
import type { EventEntry } from '../lib/events';
import { u } from '../lib/url';
interface Props { e: EventEntry; next: Date; compact?: boolean }
const { e, next, compact = false } = Astro.props;
const colors: Record<string, string> = { Anjuna: 'var(--clay)', Dharamkot: 'var(--slate)', Lonavala: 'var(--leaf)' };
const dateLabel = next.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Asia/Kolkata' });
---
<article class="card pinned" data-event={e.id} data-location={e.data.location} style="padding:0;overflow:hidden;display:flex;flex-direction:column">
  {!compact && (
    <div style={`background:${colors[e.data.location]};height:120px;padding:14px;display:flex;justify-content:space-between;align-items:flex-start`}>
      <span class="chip label">{e.data.location}</span>
      <span class="chip label" style="background:var(--ink);color:var(--paper)">{e.data.kind}</span>
    </div>
  )}
  <div style="padding:20px;display:flex;flex-direction:column;gap:8px;flex:1">
    <p class="label" style="color:var(--leaf)">{compact ? `${e.data.location} · ` : ''}{e.data.when} · next {dateLabel}</p>
    <h3 style="font-size:26px"><a href={u(`/happenings/${e.id}/`)} style="text-decoration:none">{e.data.title}</a></h3>
    <p class="muted" style="font-size:15px">{e.data.blurb}</p>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:12px">
      <span class="muted" style="font-size:14px" data-count>&nbsp;</span>
      <button class="btn small" type="button" data-rsvp={e.id} aria-pressed="false">RSVP</button>
    </div>
  </div>
</article>
