---
import { nav } from '../data/site';
import { u } from '../lib/url';
import { upcomingEvents } from '../lib/events';

const path = Astro.url.pathname;
const upcoming = (await upcomingEvents()).slice(0, 5).map((x) => x.entry);
---
<div class="ticker label" aria-hidden="true">
  <div class="track">
    {upcoming.map((e) => <span>{e.data.location}: {e.data.title} · {e.data.when}</span>)}
    {upcoming.map((e) => <span>{e.data.location}: {e.data.title} · {e.data.when}</span>)}
  </div>
</div>
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={u('/')}>nomadgao<small>est. 2019</small></a>
    <nav id="mainnav" class="mainnav" aria-label="Main">
      {nav.map((n) => (
        <a href={u(n.href)} aria-current={path.startsWith(u(n.href)) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="header-cta">
      <a class="login btn ghost small" href={u('/village/me/')} data-auth-link>Log in</a>
      <a class="btn red small" href={u('/book/')}>Book a stay</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mainnav">Menu</button>
    </div>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const navEl = document.getElementById('mainnav');
  btn?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
