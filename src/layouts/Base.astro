---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  crumbs?: { name: string; href: string }[];
  type?: 'website' | 'article';
}
const { title, description = site.description, image, noindex = false, jsonLd, crumbs, type = 'website' } = Astro.props;
const previewMode = (import.meta.env.PUBLIC_NOINDEX ?? 'true') !== 'false';
const robots = previewMode || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('NomadGao') ? title : `${title} | NomadGao`;
const ogImage = new URL(image ?? u('/og-default.svg'), Astro.site).href;
const supabaseHost = import.meta.env.PUBLIC_SUPABASE_URL ? new URL(import.meta.env.PUBLIC_SUPABASE_URL).origin : '';

const ld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: new URL(u('/'), Astro.site).href,
    foundingDate: String(site.founded),
    sameAs: Object.values(site.social),
  },
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
if (crumbs?.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(u(c.href), Astro.site).href })),
  });
}
const csp = [
  "default-src 'self'",
  "script-src 'self' https://checkout.razorpay.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  `connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com${supabaseHost ? ' ' + supabaseHost : ''}`,
  "frame-src https://www.google.com https://www.youtube-nocookie.com https://api.razorpay.com https://checkout.razorpay.com",
  "form-action 'self' https://book.nomadgao.com",
  "base-uri 'self'",
].join('; ');
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="NomadGao Journal" href={u('/rss.xml')} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="NomadGao" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#16130F" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {previewMode && <div class="notice">Preview build. The live site is <a href="https://www.nomadgao.com">nomadgao.com</a>. Bookings here are a prototype: no real rooms or payments.</div>}
  <Header />
  <main id="main">
    {crumbs?.length && (
      <nav aria-label="Breadcrumb" class="wrap label muted" style="padding-top:12px">
        {crumbs.map((c, i) => (
          <span>{i > 0 && ' / '}{i < crumbs.length - 1 ? <a href={u(c.href)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</span>
        ))}
      </nav>
    )}
    <slot />
  </main>
  <Footer />
</body>
</html>
