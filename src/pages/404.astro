---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found" noindex>
  <section class="wrap section" style="max-width:760px">
    <p class="label" style="color:var(--laterite)">404</p>
    <h1 class="h-xl">Wrong turn in the village.</h1>
    <p class="lead muted" style="margin-top:20px">That page has moved or never existed. Try one of these:</p>
    <p style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px"><a class="btn" href={u('/stays/')}>Stays</a><a class="btn ghost" href={u('/happenings/')}>Happenings</a><a class="btn ghost" href={u('/blog/')}>Journal</a></p>
  </section>
</Base>
