---
import Base from '../../layouts/Base.astro';
import NativeBook from '../../components/NativeBook.astro';
import StayflexiBook from '../../components/StayflexiBook.astro';
import { bookingEngine } from '../../data/site';
---
<Base title="Book a stay" description="Book NomadGao Vila Nova in Anjuna, Goa or NomadGao Dharamkot, Himachal. Pick your dates and guests and see live rooms and prices." crumbs={[{ name: 'Home', href: '/' }, { name: 'Book', href: '/book/' }]}>
  {bookingEngine === 'native' ? <NativeBook /> : <StayflexiBook />}
</Base>
