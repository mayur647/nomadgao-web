# Keep the dummy site out of Google so it never competes with nomadgao.com.
# Set to false only when this site replaces the live one.
PUBLIC_NOINDEX=true

# Optional: real accounts, profiles and RSVPs. Leave empty to run in demo mode
# (data stays in the visitor's own browser).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
